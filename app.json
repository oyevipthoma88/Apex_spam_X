{
  "name": "Apex Spam X",
  "description": "Apex Spam X base + Mongo sudo + Heroku API",
  "repository": "https://github.com/oyevipthoma88/Apex_spam_X",
  "stack": "heroku-24",
  "buildpacks": [{ "url": "heroku/python" }],
  "formation": { "worker": { "quantity": 1, "size": "basic" } },
  "env": {
    "API_ID": { "required": true },
    "API_HASH": { "required": true },
    "OWNER_ID": { "required": true },
    "MONGO_DB_URI": { "required": true },
    "BOT_TOKEN1": { "required": true },
    "BOT_TOKEN2": { "required": false },
    "BOT_TOKEN3": { "required": false },
    "BOT_TOKEN4": { "required": false },
    "BOT_TOKEN5": { "required": false },
    "CMD_HNDLR": { "value": ".", "required": false },
    "SUDO_USERS": { "required": false },
    "HEROKU_APP_NAME": { "required": false },
    "HEROKU_API_KEY": { "required": false }
  }
}
